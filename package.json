{
  "name": "salt-studio",
  "private": true,
  "scripts": {
    "analyze": "next experimental-analyze --serve",
    "prebuild": "node scripts/generate-error-content.mjs",
    "build": "next build --turbopack && sanity manifest extract --path public/studio/static",
    "predev": "node scripts/ensure-typegen.mjs",
    "dev": "next --turbopack -p 4000",
    "dev:fast": "next --turbopack -p 4000",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "generate:error-content": "node scripts/generate-error-content.mjs",
    "import:projects": "sanity exec scripts/import-projects-from-csv.mjs --with-user-token",
    "lint": "eslint .",
    "lint:fix": "npm run format && npm run lint -- --fix",
    "prepare": "husky",
    "seed:copy:archived": "echo 'Archived Photon seed — see scripts/archive/photon/' && exit 1",
    "seed:team:archived": "echo 'Archived Photon seed — see scripts/archive/photon/' && exit 1",
    "start": "next start -p 4000",
    "type-check": "next typegen && tsc --noEmit",
    "typegen": "sanity schema extract && sanity typegen generate"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@next/env": "16.3.4",
    "@sanity/client": "7.20.0",
    "@sanity/dashboard": "^5.0.1",
    "@sanity/icons": "3.7.4",
    "@sanity/image-url": "2.1.1",
    "@sanity/orderable-document-list": "^2.0.23",
    "@sanity/ui": "3.1.14",
    "@sanity/util": "5.31.2",
    "@sanity/vision": "5.31.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/speed-insights": "2.0.0",
    "@vimeo/player": "^2.30.4",
    "classnames": "2.5.1",
    "date-fns": "4.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.40.0",
    "motion": "^12.38.0",
    "next": "16.3.4",
    "next-sanity": "12.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-live-transitions": "0.2.0",
    "resend": "^6.26.0",
    "rxjs": "7.8.2",
    "sanity": "5.31.2",
    "sanity-plugin-asset-source-unsplash": "7.0.25",
    "sanity-plugin-dashboard-widget-document-list": "^2.1.3",
    "sanity-plugin-media": "^4.1.1",
    "server-only": "0.0.1",
    "simple-icons": "^16.29.0",
    "sonner": "2.0.8",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@sanity/prettier-config": "3.0.0",
    "@types/react": "19.2.18",
    "autoprefixer": "10.5.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.4",
    "eslint-formatter-gha": "2.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "5.9.3"
  }
}
