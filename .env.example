# ------------------------------------------------------------------------------
# Salt Studio Website — environment variables
#
# 1PASSWORD (required workflow)
#   Vault: salt-studio-development
#   Item:  salt-studio-sanity
#
#   Field labels on the item → env vars:
#     project-id  → NEXT_PUBLIC_SANITY_PROJECT_ID
#     dataset     → NEXT_PUBLIC_SANITY_DATASET
#     read-token  → SANITY_API_READ_TOKEN
#     write-token → SANITY_API_WRITE_TOKEN
#
#   Other keys below (site, GTM, Resend, socials, agent tools) can live as
#   additional fields on the same item, or stay in .env.local / Vercel until added.
#   Never put Photon’s project id (25ywlhce) or Photon tokens in this item.
#
# Copy / inject into .env.local (gitignored). Never commit .env.local.
# ------------------------------------------------------------------------------

# --- Sanity (REQUIRED) — project jkqf2ng5 ------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=jkqf2ng5
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only read token. sanity/lib/token.ts throws if missing.
SANITY_API_READ_TOKEN=

# Write token — seeds/scripts only; never expose to the client.
SANITY_API_WRITE_TOKEN=

# --- Sanity (optional) --------------------------------------------------------
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-27
NEXT_PUBLIC_SANITY_PROJECT_TITLE=Salt Studio

# --- Analytics ----------------------------------------------------------------
# Salt Studio GTM (internal). Client GA4 is set in Sanity Developer Settings.
NEXT_PUBLIC_GTM_ID=

# --- SEO & Site Config --------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://createdbysalt.com
NEXT_PUBLIC_SITE_NAME=Salt Studio
NEXT_PUBLIC_SITE_DESCRIPTION=Subtle. Essential. Transformative.
NEXT_PUBLIC_BUSINESS_TYPE=Organization

# Social (sameAs) — leave empty until confirmed
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_VIMEO_URL=

# Set to "true" on staging/preview to block crawling.
# ROBOTS_DISALLOW_ALL=true

# --- Contact Form (Resend) ----------------------------------------------------
RESEND_API_KEY=
CONTACT_EMAIL=hello@createdbysalt.com
RESEND_FROM_EMAIL=hello@createdbysalt.com

# --- AI / scraping (optional agent tooling) -----------------------------------
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
FIRECRAWL_API_KEY=
APIFY_API_KEY=

# --- Playwright ---------------------------------------------------------------
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
